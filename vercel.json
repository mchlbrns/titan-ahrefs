{
  "version": 2,
  "name": "titan-ahrefs",
  "builds": [
    {
      "src": "api/**/*.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/report",
      "dest": "api/report.ts"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/report?format=json",
      "schedule": "0 0 * * 1"
    }
  ]
}
