{
  "name": "titan-ahrefs",
  "version": "1.0.0",
  "description": "Standalone Ahrefs API v3 SEO analytics engine, backlink monitor, SERP tracker, and historical snapshot logger for independent domains.",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "npm run dev --prefix dashboard",
    "build": "cd dashboard && npm install && npm run build",
    "start": "npm run start --prefix dashboard",
    "audit:domains": "tsx src/index.ts audit:domains",
    "usage:check": "tsx src/index.ts usage:check",
    "fetch:keywords": "tsx src/index.ts fetch:keywords",
    "fetch:toppages": "tsx src/index.ts fetch:toppages",
    "fetch:backlinks": "tsx src/index.ts fetch:backlinks",
    "analyze:competitors": "tsx src/index.ts analyze:competitors",
    "snapshot:create": "tsx src/index.ts snapshot:create",
    "report:weekly": "tsx src/index.ts report:weekly",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix"
  },
  "dependencies": {
    "lucide-react": "^0.344.0",
    "next": "14.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "keywords": [
    "ahrefs",
    "seo",
    "backlinks",
    "serp",
    "analytics",
    "rank-tracker"
  ],
  "author": "Titan Workspace Engineering",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vercel/node": "^3.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.1.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
